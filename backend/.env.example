# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/blood-bank

# Auth (use long random strings in production, e.g. `openssl rand -base64 64`)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS (comma-separated, no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# OTP
OTP_PROVIDER=log
OTP_PROVIDER_KEY=dummy-key-for-sms-provider
OTP_TTL_MINUTES=5
OTP_COOLDOWN_SECONDS=60

# PIN pepper (optional extra secret appended before bcrypt)
PIN_PEPPER=

# Seed users (used by `npm run seed`)
SEED_DOCTOR_ID=DOC-001
SEED_DOCTOR_PIN=1234
SEED_STAFF_ID=STAFF-001
SEED_STAFF_PIN=1234

# Chatbot (OpenAI via backend proxy; key never leaves server)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CHAT_MAX_TOKENS=500
